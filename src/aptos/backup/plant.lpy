from math import pi
from copy import deepcopy
from morpho import *

module Apex(agex, alpha)
module Internode(length, radius, agei)
module Leaf(area)
module Petiole(length)

ttime = 1

def StartEach():
  global ttime
  ttime +=1
  
Axiom: Internode(LEN0, RAD0, AGE0)[&(120)Petiole(0.2)Leaf(AREA0, AGE0)]Apex(AGE0, ALPHA0)
derivation length: 200
production:
Apex(agex, alpha):
  agex = deepcopy(agex)
  alpha = deepcopy(alpha)
  while agex < phyllochrone : 
    agex +=1
    produce Apex(agex, alpha)
  if alpha<360: 
    alpha+=90
  else : 
    alpha = 90
  produce Internode(0, RAD0, 0)[\(alpha)&(120)+(agex*pi)Petiole(0)Leaf(AREA0, AGE0)]Apex(0, alpha)
  
Internode(li,r, agei):
  if li< Lmax_Internode: 
    li = deepcopy(li)
    agei = deepcopy(agei)
    li+=growth_rate(agei, Lmax_Internode, tip_Internode, b_Internode)*agei
    agei+=1
    produce Internode(li,r, agei)
Leaf(area, age):
  area = deepcopy(area)
  age = deepcopy(age)
  if area < Amax_Leaf:
    GRL = growth_rate(age, Amax_Leaf, tip_Leaf, b_Leaf)*age
    area += GRL
    age+=1
    produce Leaf(area, age)
  elif area == Amax_Leaf and age < senesce:
    age +=1
    produce Leaf(area, age)
  else : 
    age +=1
    produce Senesce(area, age)
Petiole(lp):
  if lp< Lmax_Petiole:
    lp= deepcopy(lp)
    lp+= growth_rate(ttime, Lmax_Petiole, tip_Petiole, b_Petiole)*ttime
    produce Petiole(lp)

Senesce(areas,ages):
  ages = deepcopy(ages)
  while ages <fall:
    ages+=1
    produce Senesce(areas, ages)
  produce
  
  
interpretation:
Internode(li,r, agei) --> ,(0)_(r)F(li)
Leaf(area, age) --> produce ,(2)@g(leafshape,area)
Senesce(areas, ages) --> produce ,(4)@g(leafshape, areas)
Apex(agex, alpha) --> ,(3)@O
Petiole(lp) --> ,(6)_(0.01)F(lp)
endlsystem
