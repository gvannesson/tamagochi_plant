__lpy_code_version__ = 1.1

def __initialiseContext__(context):
	scalars = [('Initialisation parameter', 'Category'), ('RAD0', 'Float', 0.1, 0.0, 99.99, 2), ('AREA0', 'Float', 1.0, 0.0, 99.99, 2), ('AGE0', 'Integer', 0, 0, 100), ('LEN0', 'Float', 0.1, 0.0, 99.99, 2), ('ALPHA0', 'Float', 0.0, 0.0, 99.99, 2), ('PL0', 'Float', 0.0, 0.0, 99.99, 2), ('Maximal parameter', 'Category'), ('Lmax_Internode', 'Float', 0.5, 0.0, 99.99, 2), ('Amax_Leaf', 'Float', 6.0, 0.0, 99.99, 2), ('Lmax_Petiole', 'Float', 6.0, 0.0, 99.99, 2), ('phyllochrone', 'Integer', 10, 0, 100), ('Growth rate', 'Category'), ('tip_Internode', 'Float', 20.0, 0.0, 99.99, 2), ('tip_Leaf', 'Float', 20.0, 0.0, 99.99, 2), ('tip_Petiole', 'Float', 20.0, 0.0, 99.99, 2), ('new category', 'Category'), ('b_Internode', 'Float', 5.0, 0.0, 99.99, 2), ('b_Leaf', 'Float', 5.0, 0.0, 99.99, 2), ('b_Petiole', 'Float', 5.0, 0.0, 99.99, 2), ('new category', 'Category'), ('senesce', 'Integer', 30, 0, 100), ('fall', 'Integer', 40, 0, 100)]
	context["__scalars__"] = scalars
	for s in scalars:
		if not s[1] == "Category" : context[s[0]] = s[2]
