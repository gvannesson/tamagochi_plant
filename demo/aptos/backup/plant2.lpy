from math import pi
from copy import deepcopy
from morpho import *

module Apex(paramA)
module Internode(paramI)
module Leaf(paramL)
module Petiole(paramP)
module Senesce(paramS)

ttime = 1
Lmax_Petiole = 0.05
tip_Petiole, b_Petiole = 20, 5
Amax_Internode = 0.05
tip_Internode = 20
b_Internode = 5
Amax_Leaf = 3
phyllochrone = 10
senesce = 15
fall = 30
r = 0.05
dA = 0.04

def dS(Ei, N, C):
  return(Ei * N)
def StartEach():
  global ttime
  ttime +=1


pI = ParameterSet(area = 0.05 * r)
Axiom: Internode(pI)[&(120)Petiole(ParameterSet(length = 0))Leaf(ParameterSet(Ei = 1,age = 0, area = 0.8, N = 0.8, C = 0.8))]Apex(ParameterSet(age = 0, alpha = 0))
derivation length: 12

production:
Apex(p):
  p = p.copy()
  if p.alpha<360: 
    p.alpha+=90
  else : 
    p.alpha = 90
  if p.age == phyllochrone: 
    p.age = 0
    produce Internode(ParameterSet(area = 0))[\(p.alpha)&(120)+(p.age*pi)Petiole(ParameterSet(length = 0))Leaf(ParameterSet(Ei = 1,age = 0, area = 0.8, N = 0.8, C = 0.8))]Apex(p)
  else : 
    p.age +=1
    produce Apex(p)

Internode(p):
  if p.area< Amax_Internode: 
    p = p.copy()
    p.area += dA #growth_rate(ttime, Lmax_Internode, tip_Internode, b_Internode)*ttime
    produce Internode(p)
Leaf(p):
  p = p.copy()
  if p.area < Amax_Leaf:
    p.area += dS(p.Ei, p.N, p.C)
    p.age+=1
    produce Leaf(p)
  elif p.area == Amax_Leaf and p.age < senesce:
    p.age +=1
    produce Leaf(p)
  else : 
    p.age +=1
    produce Senesce(p)
Petiole(p):
  if p.length< Lmax_Petiole:
    p = p.copy()
    p.length+= growth_rate(ttime, Lmax_Petiole, tip_Petiole, b_Petiole)*ttime
    produce Petiole(p)

Senesce(p):
  p = p.copy() 
  while p.age <fall:
    p.age+=1
    produce Senesce(p)
  produce
  
  
interpretation:
Internode(p) --> ,(0)_(r)F(p.area / (2* pi * r))
Leaf(p) --> produce ,(2)@g(leafshape,p.area)
Senesce(p) --> produce ,(4)@g(leafshape, p.area)
Apex(p) --> ,(3)@O
Petiole(p) --> ,(6)_(0.01)F(p.length)
endlsystem